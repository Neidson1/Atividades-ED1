#include <stdio.h>

typedef struct {
    char tipo[50];
    int hp;
} Inimigo;

int main() {

    int n, i;

    printf("Digite a quantidade de inimigos: ");
    scanf("%d", &n);

    Inimigo inimigos[n];

    for (i = 0; i < n; i++) {

        printf("\nInimigo %d\n", i + 1);

        printf("Tipo: ");
        scanf("%s", inimigos[i].tipo);

        printf("HP: ");
        scanf("%d", &inimigos[i].hp);

        printf("Inimigo: %s, HP: %d\n",
               inimigos[i].tipo,
               inimigos[i].hp);
    }

    return 0;
}
