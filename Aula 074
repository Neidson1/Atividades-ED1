#include <stdio.h>

// Troca de valores
void swap(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

// Partição in-place (estilo Lomuto)
void particao(int n, int v[]) {
    int pivot = v[n - 1];
    int i = -1;

    for (int j = 0; j < n - 1; j++) {
        if (v[j] < pivot) {
            i++;
            swap(&v[i], &v[j]);
        }
    }

    // coloca o pivô na posição correta
    swap(&v[i + 1], &v[n - 1]);
}

int main() {
    int n;

    scanf("%d", &n);

    int v[n];

    for (int i = 0; i < n; i++) {
        scanf("%d", &v[i]);
    }

    particao(n, v);

    for (int i = 0; i < n; i++) {
        printf("%d", v[i]);
        if (i < n - 1) printf(" ");
    }

    printf("\n");

    return 0;
}
