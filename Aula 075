#include <stdio.h>

// Função para trocar valores
void swap(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

// Partição de Lomuto
int particiona(int v[], int inicio, int fim) {
    int pivot = v[fim];
    int i = inicio - 1;

    for (int j = inicio; j < fim; j++) {
        if (v[j] <= pivot) {
            i++;
            swap(&v[i], &v[j]);
        }
    }

    swap(&v[i + 1], &v[fim]);
    return i + 1;
}

// Quick Sort recursivo
void quickSort(int v[], int inicio, int fim) {
    if (inicio < fim) {
        int p = particiona(v, inicio, fim);

        quickSort(v, inicio, p - 1);
        quickSort(v, p + 1, fim);
    }
}

int main() {
    int N;

    scanf("%d", &N);

    int v[N];

    for (int i = 0; i < N; i++) {
        scanf("%d", &v[i]);
    }

    quickSort(v, 0, N - 1);

    for (int i = 0; i < N; i++) {
        printf("%d", v[i]);
        if (i < N - 1) printf(" ");
    }

    printf("\n");

    return 0;
}
