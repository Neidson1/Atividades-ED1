#include <stdio.h>
#include <stdlib.h>

typedef struct
{
    int id;
    char nome[50];
} Aventureiro;

typedef struct No
{
    Aventureiro dado;
    struct No *prox;
} No;

typedef struct
{
    No *inicio;
} Lista;

void adicionarAventureiro(Lista *lista, Aventureiro av)
{
    No *novo = (No *)malloc(sizeof(No));

    if (novo == NULL)
    {
        printf("Erro ao alocar memoria!\n");
        return;
    }

    novo->dado = av;
    novo->prox = lista->inicio;
    lista->inicio = novo;
}

void mostrarGrupo(Lista *lista)
{
    No *atual = lista->inicio;

    if (atual == NULL)
    {
        printf("\nGrupo vazio!\n");
        return;
    }

    printf("\n=== GRUPO DE AVENTUREIROS ===\n");

    while (atual != NULL)
    {
        printf("ID: %d | Nome: %s\n",
               atual->dado.id,
               atual->dado.nome);

        atual = atual->prox;
    }
}

int main()
{
    Lista grupo;
    grupo.inicio = NULL;

    int opcao;
    Aventureiro av;

    do
    {
        printf("\n=== MENU ===\n");
        printf("1 - Adicionar Aventureiro\n");
        printf("2 - Mostrar Grupo\n");
        printf("3 - Sair\n");
        printf("Opcao: ");
        scanf("%d", &opcao);

        switch (opcao)
        {
        case 1:
            printf("ID do aventureiro: ");
            scanf("%d", &av.id);

            printf("Nome do aventureiro: ");
            scanf(" %49[^\n]", av.nome);

            adicionarAventureiro(&grupo, av);

            printf("Aventureiro adicionado com sucesso!\n");
            break;

        case 2:
            mostrarGrupo(&grupo);
            break;

        case 3:
            printf("Encerrando programa...\n");
            break;

        default:
            printf("Opcao invalida!\n");
        }

    } while (opcao != 3);

    return 0;
}
