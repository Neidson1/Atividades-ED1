#include <stdio.h>

// Struct para armazenar os dados do jogador
typedef struct {
    char nome[50];
    int pontuacao;
} Jogador;

int main() {

    int N, i, j;

    // Leitura da quantidade de jogadores
    printf("Digite a quantidade de jogadores: ");
    scanf("%d", &N);

    // Vetor de jogadores
    Jogador jogadores[N];

    // Leitura dos dados
    for (i = 0; i < N; i++) {

        printf("\nJogador %d\n", i + 1);

        printf("Nome: ");
        scanf("%s", jogadores[i].nome);

        printf("Pontuacao: ");
        scanf("%d", &jogadores[i].pontuacao);
    }

    // Insertion Sort em ordem decrescente
    for (i = 1; i < N; i++) {

        Jogador chave = jogadores[i];
        j = i - 1;

        // Desloca jogadores com menor pontuação
        while (j >= 0 &&
               jogadores[j].pontuacao < chave.pontuacao) {

            jogadores[j + 1] = jogadores[j];
            j--;
        }

        // Insere na posição correta
        jogadores[j + 1] = chave;
    }

    // Exibe ranking final
    printf("\n===== RANKING FINAL =====\n");

    for (i = 0; i < N; i++) {

        printf("%d %s\n",
               jogadores[i].pontuacao,
               jogadores[i].nome);
    }

    return 0;
}
