#include <stdio.h>

// Definição da struct com typedef
typedef struct {
    int id;
    int pontuacao;
} Jogador;

// Função para trocar jogadores
void swap(Jogador *a, Jogador *b) {
    Jogador temp = *a;
    *a = *b;
    *b = temp;
}

// Partição de Lomuto (ordem decrescente)
int particiona(Jogador v[], int inicio, int fim) {
    int pivot = v[fim].pontuacao;
    int i = inicio - 1;

    for (int j = inicio; j < fim; j++) {
        if (v[j].pontuacao >= pivot) { // decrescente
            i++;
            swap(&v[i], &v[j]);
        }
    }

    swap(&v[i + 1], &v[fim]);
    return i + 1;
}

// Quick Sort recursivo
void quickSort(Jogador v[], int inicio, int fim) {
    if (inicio < fim) {
        int p = particiona(v, inicio, fim);

        quickSort(v, inicio, p - 1);
        quickSort(v, p + 1, fim);
    }
}

int main() {
    int n;

    scanf("%d", &n);

    Jogador v[n];

    for (int i = 0; i < n; i++) {
        scanf("%d %d", &v[i].id, &v[i].pontuacao);
    }

    quickSort(v, 0, n - 1);

    for (int i = 0; i < n; i++) {
        printf("%d %d\n", v[i].id, v[i].pontuacao);
    }

    return 0;
}
