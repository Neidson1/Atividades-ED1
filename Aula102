#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Struct do feitiço
typedef struct {
    char nome[50];
    int custo_mana;
} Feitico;

// Nó da pilha
typedef struct No {
    Feitico dado;
    struct No *prox;
} No;

// Struct da pilha
typedef struct {
    No *topo;
} Pilha;

// Inicializa a pilha
void inicializar(Pilha *p) {
    p->topo = NULL;
}

// Push - adiciona ao topo
void push(Pilha *p, char nome[], int custo_mana) {

    No *novo = (No *) malloc(sizeof(No));

    if (novo == NULL) {
        printf("Erro de alocacao de memoria!\n");
        return;
    }

    strcpy(novo->dado.nome, nome);
    novo->dado.custo_mana = custo_mana;

    novo->prox = p->topo;
    p->topo = novo;

    printf("Feitico adicionado com sucesso!\n");
}

// Pop - remove do topo
Feitico pop(Pilha *p) {

    Feitico retorno;
    retorno.custo_mana = -1;

    if (p->topo == NULL) {
        printf("A pilha de comandos esta vazia!\n");
        return retorno;
    }

    No *aux = p->topo;

    retorno = aux->dado;

    p->topo = aux->prox;

    free(aux);

    return retorno;
}

// Mostra a pilha
void mostrar_pilha(Pilha *p) {

    No *aux = p->topo;

    if (aux == NULL) {
        printf("\nA pilha de comandos esta vazia.\n");
        return;
    }

    printf("\n=== PILHA DE COMANDOS ===\n");

    while (aux != NULL) {

        printf("Feitico: %s\n", aux->dado.nome);
        printf("Custo de Mana: %d\n", aux->dado.custo_mana);
        printf("---------------------\n");

        aux = aux->prox;
    }
}

// Libera toda a pilha usando pop
void liberar_pilha(Pilha *p) {

    while (p->topo != NULL) {
        pop(p);
    }
}

int main() {

    Pilha pilha;
    inicializar(&pilha);

    int opcao, custo_mana;
    char nome[50];
    Feitico f;

    do {

        printf("\n===== PILHA DE COMANDOS DO ARCANISTA =====\n");
        printf("1 - Adicionar novo feitico\n");
        printf("2 - Lancar proximo feitico\n");
        printf("3 - Mostrar pilha de comandos\n");
        printf("4 - Sair\n");
        printf("Escolha uma opcao: ");
        scanf("%d", &opcao);

        switch (opcao) {

        case 1:

            getchar();

            printf("Nome do feitico: ");
            fgets(nome, 50, stdin);
            nome[strcspn(nome, "\n")] = '\0';

            printf("Custo de mana: ");
            scanf("%d", &custo_mana);

            push(&pilha, nome, custo_mana);

            break;

        case 2:

            f = pop(&pilha);

            if (f.custo_mana != -1) {
                printf("Feitico '%s' lancado com sucesso!\n", f.nome);
            }

            break;

        case 3:

            mostrar_pilha(&pilha);

            break;

        case 4:

            liberar_pilha(&pilha);

            printf("Encerrando o programa...\n");

            break;

        default:

            printf("Opcao invalida!\n");
        }

    } while (opcao != 4);

    return 0;
}
