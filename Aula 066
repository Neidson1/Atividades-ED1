#include <stdio.h>

int main() {

    int N, i, j, temp;

    // Leitura da quantidade de jogadores
    printf("Digite a quantidade de jogadores: ");
    scanf("%d", &N);

    int pontuacoes[N];

    // Leitura das pontuações
    for (i = 0; i < N; i++) {
        scanf("%d", &pontuacoes[i]);
    }

    // Bubble Sort em ordem decrescente
    for (i = 0; i < N - 1; i++) {

        for (j = 0; j < N - 1 - i; j++) {

            // Troca se o elemento atual for menor
            if (pontuacoes[j] < pontuacoes[j + 1]) {

                temp = pontuacoes[j];
                pontuacoes[j] = pontuacoes[j + 1];
                pontuacoes[j + 1] = temp;
            }
        }
    }

    // Exibe o vetor ordenado
    printf("\nPontuacoes ordenadas:\n");

    for (i = 0; i < N; i++) {
        printf("%d ", pontuacoes[i]);
    }

    printf("\n");

    return 0;
}
