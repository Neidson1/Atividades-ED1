#include <stdio.h>
#include <stdlib.h>

typedef struct
{
    char nome[50];
    int vida;
    int ataque;
} Inimigo;

int main()
{
    FILE *arquivo;
    Inimigo inimigo;
    Inimigo maior_ameaca;
    int primeiro = 1;

    arquivo = fopen("wave_data.txt", "r");

    if (arquivo == NULL)
    {
        printf("Erro ao abrir o arquivo!\n");
        return 1;
    }

    while (fscanf(arquivo, "%s %d %d",
                  inimigo.nome,
                  &inimigo.vida,
                  &inimigo.ataque) != EOF)
    {
        if (primeiro || inimigo.ataque > maior_ameaca.ataque)
        {
            maior_ameaca = inimigo;
            primeiro = 0;
        }
    }

    printf("Maior Ameaca: %s, Vida: %d, Ataque: %d\n",
           maior_ameaca.nome,
           maior_ameaca.vida,
           maior_ameaca.ataque);

    fclose(arquivo);

    return 0;
}
