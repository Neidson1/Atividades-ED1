#include <stdio.h>

int main() {
    int n;

    // Leitura da quantidade de jogadores
    scanf("%d", &n);

    int pontuacoes[n];

    // Leitura das pontuações
    for (int i = 0; i < n; i++) {
        scanf("%d", &pontuacoes[i]);
    }

    // Bubble Sort otimizado (ordem decrescente)
    for (int i = 0; i < n - 1; i++) {
        int troca = 0;

        for (int j = 0; j < n - 1 - i; j++) {

            // Troca para manter em ordem decrescente
            if (pontuacoes[j] < pontuacoes[j + 1]) {
                int temp = pontuacoes[j];
                pontuacoes[j] = pontuacoes[j + 1];
                pontuacoes[j + 1] = temp;

                troca = 1;
            }
        }

        // Se não houve troca, o vetor já está ordenado
        if (troca == 0) {
            break;
        }
    }

    // Impressão do vetor ordenado
    for (int i = 0; i < n; i++) {
        printf("%d", pontuacoes[i]);

        if (i < n - 1) {
            printf(" ");
        }
    }

    printf("\n");

    return 0;
}
