#include <stdio.h>

// Struct do jogador
typedef struct {
    int id;
    char nickname[50];
    int reputacao;
} Jogador;

// Função de busca binária
int buscaBinaria(Jogador jogadores[], int n, int idBusca) {

    int inicio = 0;
    int fim = n - 1;
    int meio;

    while (inicio <= fim) {

        meio = (inicio + fim) / 2;

        if (jogadores[meio].id == idBusca) {
            return meio;
        }

        if (idBusca < jogadores[meio].id) {
            fim = meio - 1;
        } else {
            inicio = meio + 1;
        }
    }

    return -1;
}

int main() {

    int N, i;
    int opcao, idBusca, indice;

    // Leitura da quantidade de jogadores
    printf("Digite a quantidade de jogadores: ");
    scanf("%d", &N);

    // Vetor de jogadores
    Jogador jogadores[N];

    // Cadastro dos jogadores
    for (i = 0; i < N; i++) {

        printf("\nJogador %d\n", i + 1);

        printf("ID: ");
        scanf("%d", &jogadores[i].id);

        printf("Nickname: ");
        scanf("%s", jogadores[i].nickname);

        printf("Reputacao: ");
        scanf("%d", &jogadores[i].reputacao);
    }

    // Menu principal
    do {

        printf("\n===== MENU =====\n");
        printf("1 - Adicionar Reputacao\n");
        printf("2 - Sair\n");
        printf("Escolha uma opcao: ");
        scanf("%d", &opcao);

        switch(opcao) {

            case 1:

                printf("\nDigite o ID do jogador: ");
                scanf("%d", &idBusca);

                // Busca binária
                indice = buscaBinaria(jogadores, N, idBusca);

                if (indice != -1) {

                    // Adiciona reputação
                    jogadores[indice].reputacao += 100;

                    printf("Nickname: %s, Nova Reputacao: %d\n",
                           jogadores[indice].nickname,
                           jogadores[indice].reputacao);

                } else {

                    printf("Jogador com ID %d nao encontrado.\n",
                           idBusca);
                }

                break;

            case 2:
                printf("\nEncerrando programa...\n");
                break;

            default:
                printf("\nOpcao invalida!\n");
        }

    } while(opcao != 2);

    return 0;
} ; 
