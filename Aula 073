#include <stdio.h>

void particao(int n, int v[]) {
    int s[n];
    int pivô = v[n - 1];

    int inicio = 0;
    int fim = n - 1;

    // Percorre o vetor original e preenche o vetor auxiliar
    for (int i = 0; i < n; i++) {
        if (v[i] <= pivô) {
            s[inicio++] = v[i];
        } else {
            s[fim--] = v[i];
        }
    }

    // Copia de volta para o vetor original
    for (int i = 0; i < n; i++) {
        v[i] = s[i];
    }
}

int main() {
    int N;

    scanf("%d", &N);

    int v[N];

    for (int i = 0; i < N; i++) {
        scanf("%d", &v[i]);
    }

    particao(N, v);

    for (int i = 0; i < N; i++) {
        printf("%d", v[i]);
        if (i < N - 1) printf(" ");
    }

    printf("\n");

    return 0;
}
