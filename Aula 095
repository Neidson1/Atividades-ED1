#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Estrutura do inimigo
typedef struct Inimigo {
    int id;
    char tipo[100];
    struct Inimigo *prox;
} Inimigo;

// Estrutura da lista
typedef struct {
    Inimigo *inicio;
} Lista;

// Inicializa a lista
void inicializar(Lista *lista) {
    lista->inicio = NULL;
}

// Inserir no fim da lista
void inserir_fim(Lista *lista, int id, char tipo[]) {
    Inimigo *novo = (Inimigo *) malloc(sizeof(Inimigo));

    if (novo == NULL) {
        printf("Erro de alocacao de memoria!\n");
        return;
    }

    novo->id = id;
    strcpy(novo->tipo, tipo);
    novo->prox = NULL;

    if (lista->inicio == NULL) {
        lista->inicio = novo;
    } else {
        Inimigo *aux = lista->inicio;

        while (aux->prox != NULL) {
            aux = aux->prox;
        }

        aux->prox = novo;
    }
}

// Mostrar a lista
void mostrar_lista(Lista *lista) {
    Inimigo *aux = lista->inicio;

    if (aux == NULL) {
        printf("\nNao ha inimigos ativos.\n");
        return;
    }

    printf("\n=== INIMIGOS DA ONDA ===\n");

    while (aux != NULL) {
        printf("ID: %d\n", aux->id);
        printf("Tipo: %s\n", aux->tipo);
        printf("---------------------\n");

        aux = aux->prox;
    }
}

// Liberar memória da lista
void destruir_lista(Lista *lista) {
    Inimigo *aux = lista->inicio;
    Inimigo *temp;

    while (aux != NULL) {
        temp = aux;
        aux = aux->prox;
        free(temp);
    }

    lista->inicio = NULL;
}

// Criar uma nova lista com n inimigos
Lista criar_lista(int n) {
    Lista novaLista;
    inicializar(&novaLista);

    int id, i;
    char tipo[100];

    for (i = 0; i < n; i++) {
        printf("\nInimigo %d\n", i + 1);

        printf("ID: ");
        scanf("%d", &id);

        getchar();

        printf("Tipo: ");
        fgets(tipo, 100, stdin);
        tipo[strcspn(tipo, "\n")] = '\0';

        inserir_fim(&novaLista, id, tipo);
    }

    return novaLista;
}

int main() {
    Lista inimigos;
    inicializar(&inimigos);

    int opcao, n;

    do {
        printf("\n===== MENU =====\n");
        printf("1. Iniciar nova onda\n");
        printf("2. Mostrar inimigos ativos\n");
        printf("3. Sair\n");
        printf("Escolha uma opcao: ");
        scanf("%d", &opcao);

        switch (opcao) {

            case 1:
                printf("Quantidade de inimigos da nova onda: ");
                scanf("%d", &n);

                // Remove a onda anterior
                destruir_lista(&inimigos);

                // Cria e substitui pela nova onda
                inimigos = criar_lista(n);

                printf("\nNova onda criada com sucesso!\n");
                break;

            case 2:
                mostrar_lista(&inimigos);
                break;

            case 3:
                destruir_lista(&inimigos);
                printf("Encerrando o jogo...\n");
                break;

            default:
                printf("Opcao invalida!\n");
        }

    } while (opcao != 3);

    return 0;
}
