#include <stdio.h>
#include <stdlib.h>

int main()
{
    FILE *arquivo;
    int opcao;
    char evento[100];

    do
    {
        printf("\n=== SISTEMA DE LOG DE EVENTOS ===\n");
        printf("1 - Registrar novo evento\n");
        printf("2 - Sair\n");
        printf("Opcao: ");
        scanf("%d", &opcao);

        switch(opcao)
        {
            case 1:

                printf("Digite o evento: ");
                scanf("%s", evento);

                arquivo = fopen("game_log.txt", "a");

                if (arquivo == NULL)
                {
                    printf("Erro ao abrir o arquivo!\n");
                    return 1;
                }

                fprintf(arquivo, "%s\n", evento);

                fclose(arquivo);

                printf("Evento registrado com sucesso!\n");
                break;

            case 2:

                printf("Encerrando sistema...\n");
                break;

            default:

                printf("Opcao invalida!\n");
        }

    } while (opcao != 2);

    return 0;
}
